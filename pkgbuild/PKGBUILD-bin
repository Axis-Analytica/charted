# Maintainer: Axis Analytica <https://github.com/Axis-Analytica>
# AUR: charted-bin — the release build from GitHub (bin/release makes the tarballs).
pkgname=charted-bin
pkgver=1.0.0
pkgrel=1
pkgdesc="A local-first Power BI Desktop alternative: load data, model it, build interactive reports (release build)"
arch=('x86_64' 'aarch64')
url="https://github.com/Axis-Analytica/charted"
license=('Apache-2.0')
depends=('webkit2gtk-4.1' 'gtk3' 'dbus' 'xdg-desktop-portal' 'hicolor-icon-theme' 'shared-mime-info' 'desktop-file-utils')
optdepends=('xdg-desktop-portal-gtk: file dialogs'
            'gnome-keyring: PostgreSQL passwords (any Secret Service keyring)')
provides=('charted')
conflicts=('charted')
options=('!strip' '!debug')
source_x86_64=("$url/releases/download/v$pkgver/charted-$pkgver-x86_64.tar.gz")
source_aarch64=("$url/releases/download/v$pkgver/charted-$pkgver-aarch64.tar.gz")
# Filled in from the release's SHA256SUMS when publishing.
sha256sums_x86_64=('SKIP')
sha256sums_aarch64=('SKIP')

package() {
  cp -a "$srcdir/charted-$pkgver/usr" "$pkgdir/"
}
