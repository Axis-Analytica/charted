<?xml version="1.0" encoding="UTF-8"?>
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-charted">
    <comment>charted project</comment>
    <comment xml:lang="da">charted-projekt</comment>
    <comment xml:lang="ar">مشروع charted</comment>
    <sub-class-of type="application/json"/>
    <glob pattern="*.charted"/>
    <icon name="charted"/>
  </mime-type>
  <mime-type type="application/x-charted-bundle">
    <comment>charted bundle</comment>
    <comment xml:lang="da">charted-pakke</comment>
    <comment xml:lang="ar">حزمة charted</comment>
    <sub-class-of type="application/zip"/>
    <glob pattern="*.chartedz"/>
    <icon name="charted"/>
  </mime-type>
  <mime-type type="application/x-powerbi-project">
    <comment>Power BI project</comment>
    <comment xml:lang="da">Power BI-projekt</comment>
    <comment xml:lang="ar">مشروع Power BI</comment>
    <sub-class-of type="application/json"/>
    <glob pattern="*.pbip"/>
  </mime-type>
</mime-info>
