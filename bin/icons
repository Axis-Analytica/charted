#!/usr/bin/env bash
# Renders every app icon from pkgbuild/charted.svg (the one source).
set -euo pipefail
cd "$(dirname "$0")/.."
svg=pkgbuild/charted.svg
r() { rsvg-convert -w "$1" -h "$1" "$svg" -o "$2"; }
cp "$svg" ui/public/favicon.svg
for s in 32 64 128 256; do r "$s" "pkgbuild/icons/$s.png"; done
r 32 src-tauri/icons/32x32.png
r 64 src-tauri/icons/64x64.png
r 128 src-tauri/icons/128x128.png
r 256 src-tauri/icons/128x128@2x.png
r 512 src-tauri/icons/icon.png
echo "icons rendered from $svg"
