#!/bin/bash
# Builds the DAX editor's language service into ui/src/dax/pkg (bin/wasm.mjs), memory-
# capped and one at a time across checkouts and agents (see bin/heavy).
set -euo pipefail
cd "$(dirname "$0")/.."
[ -n "${CHARTED_HEAVY:-}" ] || exec bin/heavy "$0" "$@"
. bin/env
exec node bin/wasm.mjs
