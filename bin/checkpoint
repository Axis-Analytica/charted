#!/bin/bash
# bin/checkpoint mN — prepares a milestone review: builds charted, creates a fresh
# sample project, captures screenshots into ~/Work/charted-checkpoints/mN/, then opens
# the app with the sample so the demo in docs/demos/mN.md can be followed live.
set -euo pipefail
cd "$(dirname "$0")/.."
. bin/env
m="${1:?usage: bin/checkpoint m0}"
out="$HOME/Work/charted-checkpoints/$m"
mkdir -p "$out"
case "$(stat -f -c %T .)" in
  ext2/ext3|ext4|btrfs|xfs|tmpfs|zfs|f2fs) ;;
  *) export CHARTED_POLL=1 ;;
esac
cargo build -q -p charted -p charted-cli
bin/wasm
demo="$HOME/Work/charted-checkpoints/Harbor & Pine"
rm -rf "$demo"
./target/debug/charted-headless sample create "$demo"
# The Data view is judged on the 10-million-row sample too (kept between runs; ~1 min to make).
big="$HOME/Work/charted-checkpoints/Harbor & Pine 10M"
if [ "$m" != m0 ] && [ ! -e "$big/Harbor & Pine.charted" ]; then
  rm -rf "$big"
  ./target/debug/charted-headless sample create "$big" --scale 10m
fi

# Browser screenshots of the scripted flows (Chromium against the real core).
e2e_tmp="${CHARTED_E2E_TMP:-/tmp/charted-e2e}"
(cd ui && CHARTED_SHOTS="$out" CHROMIUM_PATH="${CHROMIUM_PATH:-$(command -v chromium || true)}" pnpm exec playwright test "e2e/$m.spec.ts") || true
# Keep the project the tests built, to see it in the real window too.
built="$out/Harbor & Pine (built by the tests)"
rm -rf "$built"
if [ -d "$e2e_tmp/docs/charted/Harbor & Pine/report" ]; then
  cp -r "$e2e_tmp/docs/charted/Harbor & Pine" "$built"
  rm -f "$built/.cache/lock" "$built/.cache/recovery.json"
fi

# Real-window screenshots (WebKitGTK), using the live Omarchy theme.
(cd ui && exec pnpm exec vite --port 1420 --strictPort >/dev/null 2>&1) &
VITE=$!
trap 'kill $VITE 2>/dev/null' EXIT
for _ in $(seq 1 40); do curl -s -o /dev/null localhost:1420/ && break; sleep 0.25; done
curl -s -o /dev/null localhost:1420/src/main.tsx
CHARTED_SCREENSHOT_DELAY_MS=7000 ./target/debug/charted open --screenshot "$out/$m-window-welcome.png" >/dev/null
CHARTED_SCREENSHOT_DELAY_MS=7000 ./target/debug/charted open "$demo" --screenshot "$out/$m-window-project.png" >/dev/null
if [ "$m" != m0 ]; then
  CHARTED_SCREENSHOT_DELAY_MS=7000 ./target/debug/charted open "$big" --screenshot "$out/$m-window-10m.png" >/dev/null
fi
if [ -d "$built" ]; then
  CHARTED_SCREENSHOT_DELAY_MS=7000 ./target/debug/charted open "$built" --screenshot "$out/$m-window-built.png" >/dev/null
fi
if [ "$m" = m3 ] && [ -d "$built" ]; then
  # The model view and the DAX editor in the real window (WebKitGTK).
  CHARTED_SCREENSHOT_DELAY_MS=7000 CHARTED_SCREENSHOT_SCRIPT='document.querySelector("[aria-label=\"Model view\"]").click()' \
    ./target/debug/charted open "$built" --screenshot "$out/m3-window-model.png" >/dev/null
  CHARTED_SCREENSHOT_DELAY_MS=7000 CHARTED_SCREENSHOT_SCRIPT='(async () => {
      const sleep = (ms) => new Promise((r) => setTimeout(r, ms));
      document.querySelector("[aria-label=\"Data view\"]").click();
      await sleep(800);
      const item = [...document.querySelectorAll("[role=tree] [role=treeitem]")].find((e) => e.querySelector(".tree-label")?.textContent === "Sales");
      item.querySelector(".tree-label").click();
      await sleep(600);
      if (item.getAttribute("aria-expanded") !== "true") item.querySelector(".tree-chevron").click();
      await sleep(600);
      [...item.querySelectorAll(".tree-leaf")].find((e) => e.querySelector(".tree-label")?.textContent === "List Value").click();
    })()' ./target/debug/charted open "$built" --screenshot "$out/m3-window-column-formula.png" >/dev/null
fi
if [ "$m" = m4 ] && [ -d "$built" ]; then
  # A cross-filter (a matrix row chosen) and the new visuals, in the real window.
  CHARTED_SCREENSHOT_DELAY_MS=7000 CHARTED_SCREENSHOT_AFTER_MS=6000 CHARTED_SCREENSHOT_SCRIPT='(async () => {
      const sleep = (ms) => new Promise((r) => setTimeout(r, ms));
      [...document.querySelectorAll("[role=tab]")].find((e) => e.textContent === "Interactivity").click();
      await sleep(2500);
      [...document.querySelectorAll(".matrix-row-head")].find((e) => e.textContent.trim() === "Camping").click();
    })()' ./target/debug/charted open "$built" --screenshot "$out/m4-window-interactivity.png" >/dev/null
  CHARTED_SCREENSHOT_DELAY_MS=7000 CHARTED_SCREENSHOT_AFTER_MS=2500 CHARTED_SCREENSHOT_SCRIPT='[...document.querySelectorAll("[role=tab]")].find((e) => e.textContent === "Visuals").click()' \
    ./target/debug/charted open "$built" --screenshot "$out/m4-window-visuals.png" >/dev/null
fi
if [ "$m" = m5 ] && [ -d "$built" ]; then
  # The query editor in the real window, on the cleaned store list.
  CHARTED_SCREENSHOT_DELAY_MS=7000 CHARTED_SCREENSHOT_AFTER_MS=4000 CHARTED_SCREENSHOT_SCRIPT='(async () => {
      const sleep = (ms) => new Promise((r) => setTimeout(r, ms));
      document.querySelector("[aria-label=\"Transform data\"]").click();
      await sleep(1500);
      [...document.querySelectorAll(".qe-query")].find((e) => e.textContent.includes("stores_raw"))?.click();
    })()' ./target/debug/charted open "$built" --screenshot "$out/m5-window-editor.png" >/dev/null
fi
if [ "$m" = m6 ] && [ -d "$built" ]; then
  # The Trends page (last year, year to date, a drilled column chart) in the real window.
  CHARTED_SCREENSHOT_DELAY_MS=7000 CHARTED_SCREENSHOT_AFTER_MS=4000 CHARTED_SCREENSHOT_SCRIPT='[...document.querySelectorAll("[role=tab]")].find((e) => e.textContent === "Trends")?.click()' \
    ./target/debug/charted open "$built" --screenshot "$out/m6-window-trends.png" >/dev/null
  # The release build, serving its own UI (no dev server), as the package installs it.
  kill $VITE 2>/dev/null || true
  if [ -x target/release/charted ]; then
    CHARTED_SCREENSHOT_DELAY_MS=4000 ./target/release/charted open "$built" --screenshot "$out/m6-window-release.png" >/dev/null
  fi
fi
echo "Screenshots: $out"
[ -n "${CHARTED_CHECKPOINT_NO_OPEN:-}" ] && exit 0
echo "Opening charted with the sample. Follow docs/demos/$m.md."
./target/debug/charted open "$demo"
