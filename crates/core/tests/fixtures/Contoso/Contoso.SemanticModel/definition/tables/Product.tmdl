	hierarchy 'Category Hierarchy'
		lineageTag: 5b8e0d2f-1c5a-4f9d-8a3b-5c0e3f9b19c0

		level Category
			lineageTag: 6c9f1e3a-2d6b-4a0e-9b4c-6d1f4a0c2ad0
