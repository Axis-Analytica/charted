table Product
	lineageTag: 9b2e4d6f-5c9a-4f3d-8a7b-9c4e7f3bf360

	column ProductKey
		dataType: int64
		isKey
		formatString: 0
		lineageTag: 0c3f5e7a-6d0b-4a4e-9b8c-0d5f8a4cc470
		summarizeBy: none
		sourceColumn: ProductKey

		annotation SummarizationSetBy = Automatic

	column Product
