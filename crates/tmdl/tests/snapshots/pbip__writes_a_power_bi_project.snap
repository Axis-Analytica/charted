=== Shop.SemanticModel/definition/expressions.tmdl
/// The folder the data files are read from. Change it where the files live.
expression SourceFolder = "/home/me/Shop/" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]
	lineageTag: 6f1d3c2a-8b8e-4f3c-9a51-50757263654f

=== Shop.SemanticModel/definition/relationships.tmdl
relationship r-1
	isActive: false
	crossFilteringBehavior: bothDirections
	fromColumn: Sales.DateKey
	toColumn: Date.DateKey


=== Shop.SemanticModel/definition/roles/Last month's sales.tmdl
/// Sales staff
role 'Last month''s sales'
	modelPermission: read

	member 'sales@shop.example'

	tablePermission Date = 'Date'[MonthNumber] = 12

	tablePermission Sales =
			VAR x = 10
			RETURN Sales[Sales Amount] > x

	annotation chartedId = role-1


=== Shop.SemanticModel/definition/tables/Sales.tmdl
/// One row per order line
table Sales
	lineageTag: t-sales

	measure 'Total Sales' = SUM ( Sales[Sales Amount] )
		formatString: \$#,0
		displayFolder: Sales
		lineageTag: m-total

	column DateKey
		dataType: int64
		lineageTag: c-sdk
		sourceColumn: DateKey

		annotation SummarizationSetBy = Automatic

	column 'Sales Amount'
		dataType: decimal
		formatString: \$#,0.00
		lineageTag: c-amount
		sourceColumn: Sales Amount

		annotation SummarizationSetBy = Automatic

	column 'Month Of Sale' = RELATED ( 'Date'[Month Name] )
		dataType: string
		lineageTag: c-rel

		annotation SummarizationSetBy = Automatic

	annotation chartedQuery = {"id":"q1","name":"Sales","table":"sales","source":{"kind":"parquet","path":"data/sales.parquet"},"steps":[{"op":"renameColumns","renames":[["Amount","Sales Amount"]]}]}

	partition Sales = m
		mode: import
		source =
				let
				    Source = Parquet.Document(File.Contents(SourceFolder & "data/sales.parquet")),
				    #"Renamed Columns" = Table.RenameColumns(Source, {{"Amount", "Sales Amount"}})
				in
				    #"Renamed Columns"

=== Shop.SemanticModel/definition/tables/Date.tmdl
table Date
	lineageTag: t-date
	dataCategory: Time

	column DateKey
		dataType: int64
		isKey
		lineageTag: c-dk
		sourceColumn: DateKey

		annotation SummarizationSetBy = Automatic

	column 'Month Name'
		dataType: string
		lineageTag: c-month
		sourceColumn: Month Name
		sortByColumn: MonthNumber

		annotation SummarizationSetBy = Automatic

	column MonthNumber
		dataType: int64
		lineageTag: c-mnum
		sourceColumn: MonthNumber

		annotation SummarizationSetBy = Automatic

	/// Months by number
	hierarchy Calendar
		displayFolder: Dates
		lineageTag: h-cal

		level 'Month Number'
			lineageTag: 172dfe0a-81ce-4b57-a665-43d23ed17d45
			column: MonthNumber

		level Month
			lineageTag: b0aca7b2-df2e-4419-a369-748edddac156
			column: 'Month Name'

	annotation chartedQuery = {"id":"q2","name":"Date","table":"date","source":{"kind":"csv","path":"data/date.csv","header":true},"steps":[]}

	partition Date = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(SourceFolder & "data/date.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    #"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers", {{"DateKey", Int64.Type}, {"Month Name", type text}, {"MonthNumber", Int64.Type}})
				in
				    #"Changed Type"

