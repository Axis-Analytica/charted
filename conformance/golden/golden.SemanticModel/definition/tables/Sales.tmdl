table Sales
	lineageTag: Sales

	measure 'Sales Amount' = SUM ( Sales[Amount] )
		lineageTag: m:Sales Amount

	measure Quantity = SUM ( Sales[Qty] )
		lineageTag: m:Quantity

	measure Orders = COUNTROWS ( Sales )
		lineageTag: m:Orders

	measure 'Avg Price' = AVERAGE ( Sales[Price] )
		lineageTag: m:Avg Price

	measure 'Min Price' = MIN ( Sales[Price] )
		lineageTag: m:Min Price

	measure 'Max Price' = MAX ( Sales[Price] )
		lineageTag: m:Max Price

	measure 'Products Sold' = DISTINCTCOUNT ( Sales[ProductKey] )
		lineageTag: m:Products Sold

	measure Amounts = COUNT ( Sales[Amount] )
		lineageTag: m:Amounts

	measure 'Missing Amounts' = COUNTBLANK ( Sales[Amount] )
		lineageTag: m:Missing Amounts

	measure Target = SUM ( Targets[Target] )
		lineageTag: m:Target

	measure 'Product Count' = COUNTROWS ( Product )
		lineageTag: m:Product Count

	measure Colors = DISTINCTCOUNT ( Product[Color] )
		lineageTag: m:Colors

	measure 'Max List Price' = MAX ( Product[ListPrice] )
		lineageTag: m:Max List Price

	measure Gap = [Sales Amount] - [Target]
		lineageTag: m:Gap

	measure 'Price Per Unit' = DIVIDE ( [Sales Amount], [Quantity] )
		lineageTag: m:Price Per Unit

	measure 'Vs Target' = DIVIDE ( [Sales Amount], [Target], 0 )
		lineageTag: m:Vs Target

	measure 'Double Qty' = [Quantity] * 2
		lineageTag: m:Double Qty

	measure 'Neg Qty' = -[Quantity]
		lineageTag: m:Neg Qty

	measure 'Qty Squared' = [Quantity] ^ 2
		lineageTag: m:Qty Squared

	measure 'Rounded PPU' = ROUND ( [Price Per Unit], 1 )
		lineageTag: m:Rounded PPU

	measure 'Abs Gap' = ABS ( [Gap] )
		lineageTag: m:Abs Gap

	measure 'Sales Or Target' = COALESCE ( [Sales Amount], [Target] )
		lineageTag: m:Sales Or Target

	measure 'Plus Blank' = [Sales Amount] + BLANK ()
		lineageTag: m:Plus Blank

	measure Big = IF ( [Quantity] > 10, "High", "Low" )
		lineageTag: m:Big

	measure 'Big Or Blank' = IF ( [Quantity] > 10, [Quantity] )
		lineageTag: m:Big Or Blank

	measure Tier = SWITCH ( TRUE (), [Quantity] >= 20, "A", [Quantity] >= 8, "B", "C" )
		lineageTag: m:Tier

	measure 'Has Missing' = IF ( ISBLANK ( [Missing Amounts] ), 0, 1 )
		lineageTag: m:Has Missing

	measure 'And Or' = IF ( [Quantity] > 5 && NOT ( [Orders] < 2 ) || [Quantity] = 1, 1, 0 )
		lineageTag: m:And Or

	measure 'In List' = IF ( [Orders] IN { 1, 2, 3 }, "few", "many" )
		lineageTag: m:In List

	measure 'Var Ratio' = VAR s = [Sales Amount] VAR q = [Quantity] RETURN DIVIDE ( s, q ) * 100
		lineageTag: m:Var Ratio

	measure 'Line Total' = SUMX ( Sales, Sales[Qty] * Sales[Price] )
		lineageTag: m:Line Total

	measure 'Avg Line' = AVERAGEX ( Sales, Sales[Qty] * Sales[Price] )
		lineageTag: m:Avg Line

	measure 'Max Line' = MAXX ( Sales, Sales[Qty] * Sales[Price] )
		lineageTag: m:Max Line

	measure 'List Value' = SUMX ( Sales, Sales[Qty] * RELATED ( Product[ListPrice] ) )
		lineageTag: m:List Value

	measure Discount = [List Value] - [Line Total]
		lineageTag: m:Discount

	measure 'Big Lines' = COUNTROWS ( FILTER ( Sales, Sales[Qty] >= 4 ) )
		lineageTag: m:Big Lines

	measure 'Green Qty' = SUMX ( FILTER ( Sales, RELATED ( Product[Color] ) = "Green" ), Sales[Qty] )
		lineageTag: m:Green Qty

	measure 'Counted Lines' = COUNTX ( Sales, Sales[Amount] )
		lineageTag: m:Counted Lines

	measure 'Avg Per Category' = AVERAGEX ( VALUES ( Product[Category] ), [Sales Amount] )
		lineageTag: m:Avg Per Category

	measure 'Best Product' = MAXX ( VALUES ( Product[Product] ), [Quantity] )
		lineageTag: m:Best Product

	measure 'Months With Sales' = COUNTROWS ( FILTER ( VALUES ( 'Date'[MonthNumber] ), [Orders] > 0 ) )
		lineageTag: m:Months With Sales

	measure 'Sum Of Max' = SUMX ( VALUES ( Store[Region] ), [Max Price] )
		lineageTag: m:Sum Of Max

	measure 'Per Product' = SUMX ( Product, [Quantity] )
		lineageTag: m:Per Product

	measure 'Listed Qty Value' = SUMX ( Product, Product[ListPrice] * [Quantity] )
		lineageTag: m:Listed Qty Value

	measure 'Per Target Row' = SUMX ( Targets, [Orders] )
		lineageTag: m:Per Target Row

	measure 'Qty Over Zero' = [Quantity] / 0
		lineageTag: m:Qty Over Zero

	measure 'Zero Over Zero' = ( [Quantity] - [Quantity] ) / 0
		lineageTag: m:Zero Over Zero

	measure 'Over Blank' = -[Quantity] / BLANK ()
		lineageTag: m:Over Blank

	measure 'Infinite Texts' = "" & [Quantity] / 0 & "|" & -[Quantity] / 0 & "|" & ( [Quantity] - [Quantity] ) / 0
		lineageTag: m:Infinite Texts

	measure 'Targets On Order Months' = CALCULATE ( SUM ( Targets[Target] ), TREATAS ( VALUES ( Sales[OrderDateKey] ), Targets[DateKey] ) )
		lineageTag: m:Targets On Order Months

	measure 'Qty Red Green' = CALCULATE ( [Quantity], TREATAS ( { "Red", "Green", "Purple" }, Product[Color] ) )
		lineageTag: m:Qty Red Green

	measure 'Targets On Order Stores' = CALCULATE ( SUM ( Targets[Target] ), TREATAS ( ALL ( Sales[OrderDateKey], Sales[StoreKey] ), Targets[DateKey], Targets[StoreKey] ) )
		lineageTag: m:Targets On Order Stores

	measure 'Value Of Text' = VALUE ( " 1,234 " ) + VALUE ( "$5" ) + VALUE ( "2024-01-02" ) + [Quantity]
		lineageTag: m:Value Of Text

	measure 'Path Pieces' = PATHITEM ( "4|5|6", MAX ( Store[StoreKey] ) ) & "/" & PATHITEMREVERSE ( "4|5|6", MIN ( Store[StoreKey] ), INTEGER ) & "/" & PATHLENGTH ( "4|5|6" ) & "/" & PATHCONTAINS ( "4|5|6", MAX ( Store[StoreKey] ) + 3 )
		lineageTag: m:Path Pieces

	measure 'Target Rows' = SUMX ( Targets, [Orders] * 0 + 1 )
		lineageTag: m:Target Rows

	measure 'Last Order Plus' = MAX ( Sales[OrderedAt] ) + 180.25
		lineageTag: m:Last Order Plus

	measure 'Month End Minus' = MAX ( 'Date'[Date] ) - 1.5
		lineageTag: m:Month End Minus

	measure 'Orders Late In Month' = COUNTROWS ( FILTER ( Sales, Sales[OrderedAt] >= RELATED ( 'Date'[Date] ) - 10.5 ) )
		lineageTag: m:Orders Late In Month

	measure 'Days Spanned' = INT ( MAX ( Sales[OrderedAt] ) - MIN ( Sales[OrderedAt] ) )
		lineageTag: m:Days Spanned

	measure 'Date Serial' = MAX ( 'Date'[Date] ) * 1
		lineageTag: m:Date Serial

	measure 'Before Serial' = COUNTROWS ( FILTER ( Sales, Sales[OrderedAt] < 45500 ) )
		lineageTag: m:Before Serial

	measure 'Hours Since Order' = ( NOW () - MAX ( Sales[OrderedAt] ) ) * 24
		lineageTag: m:Hours Since Order

	measure 'Days To Today' = UTCTODAY () - MAX ( 'Date'[Date] )
		lineageTag: m:Days To Today

	measure 'A Week From Now' = UTCNOW () + 7
		lineageTag: m:A Week From Now

	measure 'Median Qty' = MEDIAN ( Sales[Qty] )
		lineageTag: m:Median Qty

	measure 'Median Line' = MEDIANX ( Sales, Sales[Qty] * Sales[Price] )
		lineageTag: m:Median Line

	measure 'P90 Price' = PERCENTILE.INC ( Sales[Price], 0.9 )
		lineageTag: m:P90 Price

	measure 'P50 Exc Qty' = PERCENTILE.EXC ( Sales[Qty], 0.5 )
		lineageTag: m:P50 Exc Qty

	measure 'P75 Product Qty' = PERCENTILEX.INC ( VALUES ( Product[Product] ), [Quantity], 0.75 )
		lineageTag: m:P75 Product Qty

	measure 'P Var K' = VAR k = 0.3 RETURN PERCENTILEX.EXC ( Sales, Sales[Qty] * 2, k + 0.2 )
		lineageTag: m:P Var K

	measure 'Stdev Qty' = STDEV.S ( Sales[Qty] )
		lineageTag: m:Stdev Qty

	measure 'Stdev P Price' = STDEV.P ( Sales[Price] )
		lineageTag: m:Stdev P Price

	measure 'Var Qty' = VAR.S ( Sales[Qty] )
		lineageTag: m:Var Qty

	measure 'Var P Line' = VARX.P ( Sales, Sales[Qty] * Sales[Price] )
		lineageTag: m:Var P Line

	measure 'Stdev Product Qty' = STDEVX.S ( VALUES ( Product[Product] ), [Quantity] )
		lineageTag: m:Stdev Product Qty

	measure 'Product Of Orders' = PRODUCTX ( VALUES ( Product[Category] ), [Orders] )
		lineageTag: m:Product Of Orders

	measure 'Geomean Price' = GEOMEAN ( Product[ListPrice] )
		lineageTag: m:Geomean Price

	measure 'Geomean Qty' = GEOMEANX ( Sales, Sales[Qty] )
		lineageTag: m:Geomean Qty

	measure 'Order Times' = DISTINCTCOUNTNOBLANK ( Sales[OrderedAt] )
		lineageTag: m:Order Times

	measure 'Order Times All' = DISTINCTCOUNT ( Sales[OrderedAt] )
		lineageTag: m:Order Times All

	measure 'Approx Products' = APPROXIMATEDISTINCTCOUNT ( Sales[ProductKey] )
		lineageTag: m:Approx Products

	measure 'Avg A Qty' = AVERAGEA ( Sales[Qty] )
		lineageTag: m:Avg A Qty

	measure 'Min A Price' = MINA ( Sales[Price] )
		lineageTag: m:Min A Price

	measure 'Max A Price' = MAXA ( Sales[Price] )
		lineageTag: m:Max A Price

	measure 'Timed Orders' = COUNTAX ( Sales, Sales[OrderedAt] )
		lineageTag: m:Timed Orders

	measure 'Ceiling Amount' = CEILING ( [Sales Amount] / 7, 5 )
		lineageTag: m:Ceiling Amount

	measure 'Floor Neg' = FLOOR ( -[Quantity] / 3, -2 )
		lineageTag: m:Floor Neg

	measure 'Iso Ceiling' = ISO.CEILING ( -[Quantity] / 4, 3 ) + ISO.CEILING ( [Quantity] / 4, -3 )
		lineageTag: m:Iso Ceiling

	measure 'Round Up Avg' = ROUNDUP ( [Avg Line], 1 )
		lineageTag: m:Round Up Avg

	measure 'Round Down Avg' = ROUNDDOWN ( [Avg Line], -1 )
		lineageTag: m:Round Down Avg

	measure 'Trunc Avg' = TRUNC ( [Avg Line] ) + TRUNC ( -[Avg Line], 2 )
		lineageTag: m:Trunc Avg

	measure 'MRound Qty' = MROUND ( [Quantity], 4 )
		lineageTag: m:MRound Qty

	measure 'Even Odd' = EVEN ( [Quantity] / 3 ) + ODD ( -[Quantity] / 3 )
		lineageTag: m:Even Odd

	measure 'Sqrt Qty' = SQRT ( [Quantity] ) + SQRTPI ( [Orders] )
		lineageTag: m:Sqrt Qty

	measure 'Power Qty' = POWER ( [Quantity], 0.5 ) + POWER ( 2, [Orders] / 10 )
		lineageTag: m:Power Qty

	measure 'Exp Ln' = LN ( [Sales Amount] ) + EXP ( [Quantity] / 100 )
		lineageTag: m:Exp Ln

	measure Logs = LOG ( [Sales Amount], 2 ) + LOG ( [Sales Amount] ) + LOG10 ( [Quantity] )
		lineageTag: m:Logs

	measure 'Sign Qty' = SIGN ( [Quantity] - 30 )
		lineageTag: m:Sign Qty

	measure 'Quotient Amount' = QUOTIENT ( [Sales Amount], 7 )
		lineageTag: m:Quotient Amount

	measure 'Fact Orders' = FACT ( MOD ( [Orders], 12 ) )
		lineageTag: m:Fact Orders

	measure 'Gcd Lcm' = GCD ( [Quantity], 12 ) + LCM ( [Orders], 4 )
		lineageTag: m:Gcd Lcm

	measure Angles = DEGREES ( [Quantity] ) + RADIANS ( [Orders] )
		lineageTag: m:Angles

	measure Trig = SIN ( [Quantity] ) + COS ( [Orders] ) + TAN ( [Quantity] / 100 ) + COT ( [Orders] )
		lineageTag: m:Trig

	measure Arcs = ASIN ( DIVIDE ( [Orders], [Orders] + 1 ) ) + ACOS ( DIVIDE ( 1, [Orders] ) ) + ATAN ( [Quantity] ) + ACOT ( [Orders] )
		lineageTag: m:Arcs

	measure Hyperbolic = SINH ( [Quantity] / 50 ) + COSH ( [Orders] / 50 ) + TANH ( [Quantity] / 50 ) + COTH ( [Orders] / 50 )
		lineageTag: m:Hyperbolic

	measure 'Inverse Hyperbolic' = ASINH ( [Quantity] ) + ACOSH ( [Orders] ) + ATANH ( DIVIDE ( [Orders], [Orders] + 1 ) ) + ACOTH ( [Orders] + 1 )
		lineageTag: m:Inverse Hyperbolic

	measure 'Currency Avg' = CURRENCY ( [Avg Line] / 7 )
		lineageTag: m:Currency Avg

	measure 'Rand Check' = IF ( RAND () < 1, 1 ) + RANDBETWEEN ( 3, 3 )
		lineageTag: m:Rand Check

	measure 'Min With NaN' = MINX ( VALUES ( Store[Region] ), IF ( Store[Region] = "North", 0 / 0, 5 ) )
		lineageTag: m:Min With NaN

	measure 'Max With NaN' = MAXX ( VALUES ( Store[Region] ), IF ( Store[Region] = "North", 0 / 0, 5 ) )
		lineageTag: m:Max With NaN

	measure 'Math Of Blank' = "ceil:" & ROUND ( CEILING ( BLANK (), 2 ), 6 ) & " " & "floor:" & ROUND ( FLOOR ( BLANK (), 2 ), 6 ) & " " & "iso:" & ROUND ( ISO.CEILING ( BLANK () ), 6 ) & " " & "up:" & ROUND ( ROUNDUP ( BLANK (), 1 ), 6 ) & " " & "down:" & ROUND ( ROUNDDOWN ( BLANK (), 1 ), 6 ) & " " & "trunc:" & ROUND ( TRUNC ( BLANK () ), 6 ) & " " & "mround:" & ROUND ( MROUND ( BLANK (), 3 ), 6 ) & " " & "even:" & ROUND ( EVEN ( BLANK () ), 6 ) & " " & "odd:" & ROUND ( ODD ( BLANK () ), 6 ) & " " & "sqrt:" & ROUND ( SQRT ( BLANK () ), 6 ) & " " & "sqrtpi:" & ROUND ( SQRTPI ( BLANK () ), 6 ) & " " & "pow:" & ROUND ( POWER ( BLANK (), 2 ), 6 ) & " " & "exp:" & ROUND ( EXP ( BLANK () ), 6 ) & " " & "sign:" & ROUND ( SIGN ( BLANK () ), 6 ) & " " & "quot:" & ROUND ( QUOTIENT ( BLANK (), 2 ), 6 ) & " " & "fact:" & ROUND ( FACT ( BLANK () ), 6 ) & " " & "gcd:" & ROUND ( GCD ( BLANK (), 4 ), 6 ) & " " & "lcm:" & ROUND ( LCM ( BLANK (), 4 ), 6 ) & " " & "deg:" & ROUND ( DEGREES ( BLANK () ), 6 ) & " " & "rad:" & ROUND ( RADIANS ( BLANK () ), 6 ) & " " & "sin:" & ROUND ( SIN ( BLANK () ), 6 ) & " " & "cos:" & ROUND ( COS ( BLANK () ), 6 ) & " " & "tan:" & ROUND ( TAN ( BLANK () ), 6 ) & " " & "asin:" & ROUND ( ASIN ( BLANK () ), 6 ) & " " & "acos:" & ROUND ( ACOS ( BLANK () ), 6 ) & " " & "atan:" & ROUND ( ATAN ( BLANK () ), 6 ) & " " & "acot:" & ROUND ( ACOT ( BLANK () ), 6 ) & " " & "sinh:" & ROUND ( SINH ( BLANK () ), 6 ) & " " & "cosh:" & ROUND ( COSH ( BLANK () ), 6 ) & " " & "tanh:" & ROUND ( TANH ( BLANK () ), 6 ) & " " & "asinh:" & ROUND ( ASINH ( BLANK () ), 6 ) & " " & "atanh:" & ROUND ( ATANH ( BLANK () ), 6 ) & " " & "cur:" & ROUND ( CURRENCY ( BLANK () ), 6 ) & " "
		lineageTag: m:Math Of Blank

	measure 'Math Blank Second' = "ceil:" & ROUND ( CEILING ( 2.5, BLANK () ), 6 ) & " " & "floor0:" & ROUND ( ROUNDUP ( 2.15, BLANK () ), 6 ) & " " & "pow:" & ROUND ( POWER ( 2, BLANK () ), 6 ) & " " & "mround:" & ROUND ( MROUND ( 7, BLANK () ), 6 ) & " " & "gcd:" & ROUND ( GCD ( 12, BLANK () ), 6 ) & " " & "lcm:" & ROUND ( LCM ( 12, BLANK () ), 6 ) & " " & "iso:" & ROUND ( ISO.CEILING ( 2.5, BLANK () ), 6 ) & " " & "trunc:" & ROUND ( TRUNC ( 2.567, BLANK () ), 6 ) & " "
		lineageTag: m:Math Blank Second

	measure 'Math Signs' = "c1:" & ROUND ( CEILING ( -5, 2 ), 6 ) & " " & "f1:" & ROUND ( FLOOR ( -5, 2 ), 6 ) & " " & "c2:" & ROUND ( CEILING ( -5, -2 ), 6 ) & " " & "f2:" & ROUND ( FLOOR ( -5, -2 ), 6 ) & " " & "c3:" & ROUND ( CEILING ( 4.2, 0.1 ), 6 ) & " " & "f3:" & ROUND ( FLOOR ( 4.2, 0.1 ), 6 ) & " " & "iso:" & ROUND ( ISO.CEILING ( -4.5, -2 ), 6 ) & " " & "odd0:" & ROUND ( ODD ( 0 ), 6 ) & " " & "even:" & ROUND ( EVEN ( -0.5 ), 6 ) & " " & "odd:" & ROUND ( ODD ( -1.5 ), 6 ) & " " & "mr:" & ROUND ( MROUND ( 1.3, 0.2 ), 6 ) & " " & "mr2:" & ROUND ( MROUND ( -7, -3 ), 6 ) & " " & "ru:" & ROUND ( ROUNDUP ( 3.2, 1 ), 6 ) & " " & "rd:" & ROUND ( ROUNDDOWN ( -3.14159, 3 ), 6 ) & " " & "ru2:" & ROUND ( ROUNDUP ( 1234.5, -2 ), 6 ) & " " & "tr:" & ROUND ( TRUNC ( -8.9 ), 6 ) & " " & "q:" & ROUND ( QUOTIENT ( -7, 2 ), 6 ) & " " & "fact:" & ROUND ( FACT ( 5.9 ), 6 ) & " " & "gcd:" & ROUND ( GCD ( 24.9, 36 ), 6 ) & " " & "lcm:" & ROUND ( LCM ( 0, 5 ), 6 ) & " " & "cur:" & ROUND ( CURRENCY ( 1.23456 ), 6 ) & " " & "pow:" & ROUND ( POWER ( -8, 1 / 3 ), 6 ) & " " & "log:" & ROUND ( LOG ( 8, 2 ), 6 ) & " " & "true:" & ROUND ( SQRT ( TRUE () ), 6 ) & " " & "sinhbig:" & ROUND ( TANH ( 30 ), 6 ) & " "
		lineageTag: m:Math Signs

	measure 'Math Edge 1' = SQRT ( -1 )
		lineageTag: m:Math Edge 1

	measure 'Math Edge 2' = LN ( 0 )
		lineageTag: m:Math Edge 2

	measure 'Math Edge 3' = LN ( BLANK () )
		lineageTag: m:Math Edge 3

	measure 'Math Edge 4' = LOG ( BLANK () )
		lineageTag: m:Math Edge 4

	measure 'Math Edge 5' = LOG ( 100, BLANK () )
		lineageTag: m:Math Edge 5

	measure 'Math Edge 6' = LOG ( 10, 1 )
		lineageTag: m:Math Edge 6

	measure 'Math Edge 7' = LOG10 ( BLANK () )
		lineageTag: m:Math Edge 7

	measure 'Math Edge 8' = FACT ( -1 )
		lineageTag: m:Math Edge 8

	measure 'Math Edge 9' = FACT ( 171 )
		lineageTag: m:Math Edge 9

	measure 'Math Edge 10' = ASIN ( 2 )
		lineageTag: m:Math Edge 10

	measure 'Math Edge 11' = MROUND ( 5, -2 )
		lineageTag: m:Math Edge 11

	measure 'Math Edge 12' = CEILING ( 5, -1 )
		lineageTag: m:Math Edge 12

	measure 'Math Edge 13' = FLOOR ( 5, 0 )
		lineageTag: m:Math Edge 13

	measure 'Math Edge 14' = FLOOR ( 2.5, BLANK () )
		lineageTag: m:Math Edge 14

	measure 'Math Edge 15' = QUOTIENT ( 1, 0 )
		lineageTag: m:Math Edge 15

	measure 'Math Edge 16' = QUOTIENT ( 7, BLANK () )
		lineageTag: m:Math Edge 16

	measure 'Math Edge 17' = COT ( 0 )
		lineageTag: m:Math Edge 17

	measure 'Math Edge 18' = COT ( BLANK () )
		lineageTag: m:Math Edge 18

	measure 'Math Edge 19' = COTH ( BLANK () )
		lineageTag: m:Math Edge 19

	measure 'Math Edge 20' = GCD ( -1, 2 )
		lineageTag: m:Math Edge 20

	measure 'Math Edge 21' = ACOSH ( 0.5 )
		lineageTag: m:Math Edge 21

	measure 'Math Edge 22' = ACOSH ( BLANK () )
		lineageTag: m:Math Edge 22

	measure 'Math Edge 23' = ATANH ( 1 )
		lineageTag: m:Math Edge 23

	measure 'Math Edge 24' = ACOTH ( BLANK () )
		lineageTag: m:Math Edge 24

	measure 'Math Edge 25' = POWER ( 0, -1 )
		lineageTag: m:Math Edge 25

	measure 'Math Edge 26' = SQRTPI ( -1 )
		lineageTag: m:Math Edge 26

	measure 'Find Category' = FIND ( "p", SELECTEDVALUE ( Product[Category] ) & "", 1, 0 )
		lineageTag: m:Find Category

	measure 'Search Product' = SEARCH ( "t*n", SELECTEDVALUE ( Product[Product] ) & "", 1, -1 )
		lineageTag: m:Search Product

	measure 'Search Dynamic' = SEARCH ( LEFT ( SELECTEDVALUE ( Product[Color] ), 2 ), "the red, green or black", 1, BLANK () )
		lineageTag: m:Search Dynamic

	measure 'Fixed Amount' = FIXED ( [Sales Amount] / 3, 1 )
		lineageTag: m:Fixed Amount

	measure 'Rept Bar' = REPT ( "|", [Orders] / 5 )
		lineageTag: m:Rept Bar

	measure Combined = COMBINEVALUES ( " / ", SELECTEDVALUE ( Product[Category] ), [Orders] )
		lineageTag: m:Combined

	measure 'Text Probes' = "f1:" & FIND ( "b", "abcb" ) & " " & "f2:" & FIND ( "b", "abcb", 3 ) & " " & "f3:" & FIND ( "B", "abc", 1, -1 ) & " " & "f4:" & FIND ( "x", "abc", 1, BLANK () ) & " " & "f5:" & FIND ( "", "abc" ) & " " & "f6:" & FIND ( "c", "abc", 4, 0 ) & " " & "s1:" & SEARCH ( "B", "abc" ) & " " & "s2:" & SEARCH ( "b?d", "xabcd" ) & " " & "s3:" & SEARCH ( "a*c", "xxabbbc" ) & " " & "s4:" & SEARCH ( "~*", "a*b" ) & " " & "s5:" & SEARCH ( "~?", "a?b" ) & " " & "s6:" & SEARCH ( ".", "a.b" ) & " " & "s7:" & SEARCH ( "*", "abc" ) & " " & "s8:" & SEARCH ( "(", "a(b" ) & " " & "c1:" & CONTAINSSTRING ( "Hello", "ELL" ) & " " & "c2:" & CONTAINSSTRING ( "Hello", "h*o" ) & " " & "c3:" & CONTAINSSTRING ( BLANK (), "" ) & " " & "x1:" & CONTAINSSTRINGEXACT ( "Hello", "ell" ) & " " & "x2:" & CONTAINSSTRINGEXACT ( "Hello", "ELL" ) & " " & "e1:" & EXACT ( "a", "A" ) & " " & "e2:" & EXACT ( BLANK (), "" ) & " " & "e3:" & EXACT ( 1, "1" ) & " " & "r1:" & REPLACE ( "abcdef", 2, 3, "X" ) & " " & "r2:" & REPLACE ( BLANK (), 1, 0, "x" ) & " " & "r3:" & REPLACE ( "abc", 5, 2, "Z" ) & " " & "p1:" & REPT ( "ab", 2.7 ) & " " & "p2:" & REPT ( BLANK (), 2 ) & " " & "p3:" & REPT ( "x", BLANK () ) & " "
		lineageTag: m:Text Probes

	measure 'Text Probes 2' = "x1:" & FIXED ( 1234.567 ) & " " & "x2:" & FIXED ( 1234.567, 1, TRUE () ) & " " & "x3:" & FIXED ( -0.001, 2 ) & " " & "x4:" & FIXED ( 1234.5, -2 ) & " " & "x5:" & FIXED ( 2.5, 0 ) & " " & "x6:" & FIXED ( -1234567.891, 2 ) & " " & "x7:" & FIXED ( 0.125, 2 ) & " " & "u1:" & UNICHAR ( 65 ) & " " & "u2:" & UNICODE ( "abc" ) & " " & "u3:" & UNICHAR ( 8364 ) & " " & "cv:" & COMBINEVALUES ( "-", "a", BLANK (), 3 ) & " " & "cv2:" & COMBINEVALUES ( ",", 1.5, TRUE () ) & " "
		lineageTag: m:Text Probes 2

	measure 'Text Edge 1' = UNICODE ( BLANK () )
		lineageTag: m:Text Edge 1

	measure 'Text Edge 2' = UNICHAR ( BLANK () )
		lineageTag: m:Text Edge 2

	measure 'Text Edge 3' = FIND ( BLANK (), "abc" )
		lineageTag: m:Text Edge 3

	measure 'Text Edge 4' = FIXED ( BLANK () )
		lineageTag: m:Text Edge 4

	measure 'Text Edge 5' = SEARCH ( BLANK (), "abc" )
		lineageTag: m:Text Edge 5

	measure 'Text Edge 6' = FIND ( "x", "abc" )
		lineageTag: m:Text Edge 6

	measure 'Text Edge 7' = FIND ( "a", "abc", 5 )
		lineageTag: m:Text Edge 7

	measure 'Text Edge 8' = FIND ( "a", "abc", 0 )
		lineageTag: m:Text Edge 8

	measure 'Text Edge 9' = SEARCH ( "x", "abc" )
		lineageTag: m:Text Edge 9

	measure 'Text Edge 10' = REPLACE ( "abc", 0, 1, "x" )
		lineageTag: m:Text Edge 10

	measure 'Text Edge 11' = REPT ( "a", -1 )
		lineageTag: m:Text Edge 11

	measure 'Text Edge 12' = UNICHAR ( 0 )
		lineageTag: m:Text Edge 12

	measure 'Text Edge 13' = UNICODE ( "" )
		lineageTag: m:Text Edge 13

	measure 'Text Edge 14' = FIND ( "a", BLANK () )
		lineageTag: m:Text Edge 14

	measure 'Text Edge 15' = REPLACE ( "abc", 1, -1, "x" )
		lineageTag: m:Text Edge 15

	measure 'Order Hour' = HOUR ( MAX ( Sales[OrderedAt] ) )
		lineageTag: m:Order Hour

	measure 'Order Minute Second' = MINUTE ( MIN ( Sales[OrderedAt] ) ) * 100 + SECOND ( MIN ( Sales[OrderedAt] ) )
		lineageTag: m:Order Minute Second

	measure 'Time Made' = TIME ( [Orders], 30, 15 )
		lineageTag: m:Time Made

	measure 'Week Of Last Date' = WEEKNUM ( MAX ( 'Date'[Date] ) ) * 100 + WEEKNUM ( MAX ( 'Date'[Date] ), 21 )
		lineageTag: m:Week Of Last Date

	measure 'Year Fraction' = YEARFRAC ( MIN ( 'Date'[Date] ), MAX ( 'Date'[Date] ) ) + YEARFRAC ( MIN ( 'Date'[Date] ), MAX ( 'Date'[Date] ), 3 )
		lineageTag: m:Year Fraction

	measure 'Work Days' = NETWORKDAYS ( MIN ( 'Date'[Date] ), MAX ( 'Date'[Date] ) )
		lineageTag: m:Work Days

	measure 'Work Days Fri Sat' = NETWORKDAYS ( MAX ( 'Date'[Date] ), MIN ( 'Date'[Date] ), 7 )
		lineageTag: m:Work Days Fri Sat

	measure 'Time Probes' = "h:" & ROUND ( HOUR ( DATE ( 2024, 1, 2 ) + TIME ( 12, 59, 59 ) + 0.6 / 86400 ), 6 ) & " " & "m:" & ROUND ( MINUTE ( DATE ( 2024, 1, 2 ) + TIME ( 12, 59, 59 ) + 0.6 / 86400 ), 6 ) & " " & "s:" & ROUND ( SECOND ( DATE ( 2024, 1, 2 ) + TIME ( 12, 59, 59 ) + 0.6 / 86400 ), 6 ) & " " & "h2:" & ROUND ( HOUR ( 0.75 ), 6 ) & " " & "h3:" & ROUND ( HOUR ( "2024-01-02 06:07:08" ), 6 ) & " " & "m2:" & ROUND ( MINUTE ( 1.5 / 24 ), 6 ) & " " & "t1:" & ROUND ( TIME ( 25, 0, 0 ) * 1, 6 ) & " " & "t2:" & ROUND ( TIME ( 1.9, 0, 0 ) * 1, 6 ) & " " & "t3:" & ROUND ( TIME ( 1, -30, 0 ) * 1, 6 ) & " " & "t4:" & ROUND ( TIME ( 0, 90, 30 ) * 1, 6 ) & " " & "tv1:" & ROUND ( TIMEVALUE ( "15:45" ) * 1, 6 ) & " " & "tv2:" & ROUND ( TIMEVALUE ( "3:45 PM" ) * 1, 6 ) & " " & "tv3:" & ROUND ( TIMEVALUE ( "2024-01-02 06:07:08" ) * 1, 6 ) & " " & "tv4:" & ROUND ( TIMEVALUE ( "12:30 AM" ) * 1, 6 ) & " " & "dv1:" & ROUND ( DATEVALUE ( "2024-01-15" ) * 1, 6 ) & " " & "dv2:" & ROUND ( DATEVALUE ( "1/15/2024" ) * 1, 6 ) & " " & "dv3:" & ROUND ( DATEVALUE ( "2024-01-15 10:00" ) * 1, 6 )
		lineageTag: m:Time Probes

	measure 'Date Probes' = "w1:" & ROUND ( WEEKNUM ( DATE ( 2024, 1, 1 ) ), 6 ) & " " & "w2:" & ROUND ( WEEKNUM ( DATE ( 2024, 1, 7 ) ), 6 ) & " " & "w3:" & ROUND ( WEEKNUM ( DATE ( 2024, 1, 7 ), 2 ), 6 ) & " " & "w4:" & ROUND ( WEEKNUM ( DATE ( 2021, 1, 1 ), 21 ), 6 ) & " " & "w5:" & ROUND ( WEEKNUM ( DATE ( 2024, 12, 31 ), 21 ), 6 ) & " " & "w6:" & ROUND ( WEEKNUM ( DATE ( 2024, 3, 15 ), 15 ), 6 ) & " " & "w7:" & ROUND ( WEEKNUM ( DATE ( 2023, 1, 1 ), 11 ), 6 ) & " " & "w8:" & ROUND ( WEEKNUM ( DATE ( 2024, 6, 30 ), 17 ), 6 ) & " " & "y1:" & ROUND ( YEARFRAC ( DATE ( 2024, 1, 31 ), DATE ( 2024, 3, 31 ) ), 6 ) & " " & "y2:" & ROUND ( YEARFRAC ( DATE ( 2024, 2, 29 ), DATE ( 2025, 2, 28 ) ), 6 ) & " " & "y3:" & ROUND ( YEARFRAC ( DATE ( 2025, 3, 31 ), DATE ( 2024, 1, 30 ) ), 6 ) & " " & "y4:" & ROUND ( YEARFRAC ( DATE ( 2024, 1, 1 ), DATE ( 2024, 7, 1 ), 2 ), 6 ) & " " & "y5:" & ROUND ( YEARFRAC ( DATE ( 2024, 1, 1 ), DATE ( 2024, 7, 1 ), 3 ), 6 ) & " " & "y6:" & ROUND ( YEARFRAC ( DATE ( 2024, 1, 31 ), DATE ( 2024, 2, 29 ), 4 ), 6 ) & " " & "y7:" & ROUND ( YEARFRAC ( DATE ( 2023, 2, 28 ), DATE ( 2023, 3, 31 ) ), 6 ) & " " & "n1:" & ROUND ( NETWORKDAYS ( DATE ( 2024, 1, 1 ), DATE ( 2024, 1, 31 ) ), 6 ) & " " & "n2:" & ROUND ( NETWORKDAYS ( DATE ( 2024, 1, 31 ), DATE ( 2024, 1, 1 ) ), 6 ) & " " & "n3:" & ROUND ( NETWORKDAYS ( DATE ( 2024, 1, 1 ), DATE ( 2024, 1, 31 ), 11 ), 6 ) & " " & "n4:" & ROUND ( NETWORKDAYS ( DATE ( 2024, 1, 1 ), DATE ( 2024, 1, 31 ), 7 ), 6 ) & " " & "n5:" & ROUND ( NETWORKDAYS ( DATE ( 2024, 1, 6 ), DATE ( 2024, 1, 7 ) ), 6 ) & " " & "n6:" & ROUND ( NETWORKDAYS ( DATE ( 2024, 1, 1 ) + 0.9, DATE ( 2024, 1, 2 ) ), 6 )
		lineageTag: m:Date Probes

	measure 'Date Edge 1' = HOUR ( BLANK () )
		lineageTag: m:Date Edge 1

	measure 'Date Edge 2' = WEEKNUM ( BLANK () )
		lineageTag: m:Date Edge 2

	measure 'Date Edge 3' = YEARFRAC ( BLANK (), DATE ( 1900, 6, 30 ) )
		lineageTag: m:Date Edge 3

	measure 'Date Edge 4' = NETWORKDAYS ( BLANK (), DATE ( 1900, 1, 10 ) )
		lineageTag: m:Date Edge 4

	measure 'Date Edge 5' = DATEVALUE ( BLANK () )
		lineageTag: m:Date Edge 5

	measure 'Date Edge 6' = TIMEVALUE ( BLANK () )
		lineageTag: m:Date Edge 6

	measure 'Date Edge 7' = SECOND ( BLANK () )
		lineageTag: m:Date Edge 7

	measure 'Date Edge 8' = WEEKNUM ( DATE ( 2024, 1, 1 ), 3 )
		lineageTag: m:Date Edge 8

	measure 'Date Edge 9' = TIME ( -1, 0, 0 )
		lineageTag: m:Date Edge 9

	measure 'Date Edge 10' = DATEVALUE ( "abc" )
		lineageTag: m:Date Edge 10

	measure 'Date Edge 11' = TIMEVALUE ( "abc" )
		lineageTag: m:Date Edge 11

	measure 'Date Edge 12' = NETWORKDAYS ( DATE ( 2024, 1, 1 ), DATE ( 2024, 1, 5 ), 9 )
		lineageTag: m:Date Edge 12

	measure 'Date Edge 13' = YEARFRAC ( DATE ( 2024, 1, 1 ), DATE ( 2024, 2, 1 ), 5 )
		lineageTag: m:Date Edge 13

	measure 'Date Edge 14' = YEARFRAC ( DATE ( 2024, 1, 1 ), DATE ( 2024, 2, 1 ), 1 )
		lineageTag: m:Date Edge 14

	measure 'Date Edge 15' = HOUR ( "abc" )
		lineageTag: m:Date Edge 15

	measure 'Median Parent' = MEDIAN ( Account[ParentKey] )
		lineageTag: m:Median Parent

	measure 'P50 Parent' = PERCENTILE.INC ( Account[ParentKey], 0.5 )
		lineageTag: m:P50 Parent

	measure 'P50X Parent' = PERCENTILEX.INC ( Account, Account[ParentKey], 0.5 )
		lineageTag: m:P50X Parent

	measure 'Stdev Parent' = STDEV.S ( Account[ParentKey] )
		lineageTag: m:Stdev Parent

	measure 'Avg A Parent' = AVERAGEA ( Account[ParentKey] )
		lineageTag: m:Avg A Parent

	measure 'Geomean Parent' = GEOMEAN ( Account[ParentKey] )
		lineageTag: m:Geomean Parent

	measure 'Median Product Qty' = MEDIANX ( VALUES ( Product[Product] ), [Quantity] )
		lineageTag: m:Median Product Qty

	measure 'Geomean Product Qty' = GEOMEANX ( VALUES ( Product[Product] ), [Quantity] )
		lineageTag: m:Geomean Product Qty

	measure 'Product Product Qty' = PRODUCTX ( VALUES ( Product[Product] ), [Quantity] )
		lineageTag: m:Product Product Qty

	measure 'Var Product Qty' = VARX.P ( VALUES ( Product[Product] ), [Quantity] )
		lineageTag: m:Var Product Qty

	measure 'All Products Qty' = SUMX ( ALL ( Product ), [Quantity] )
		lineageTag: m:All Products Qty

	measure 'Lines Per Product' = SUMX ( Product, COUNTROWS ( FILTER ( Sales, Sales[ProductKey] = Product[ProductKey] ) ) )
		lineageTag: m:Lines Per Product

	measure 'Selected Months' = COUNTROWS ( ALLSELECTED ( 'Date'[MonthNumber] ) )
		lineageTag: m:Selected Months

	measure 'Selected Color Qty' = SUMX ( ALLSELECTED ( Product[Color] ), [Quantity] )
		lineageTag: m:Selected Color Qty

	measure 'Selected Products' = COUNTROWS ( ALLSELECTED ( Product ) )
		lineageTag: m:Selected Products

	measure 'Share Of Selected' = DIVIDE ( [Quantity], SUMX ( ALLSELECTED ( Product[Product] ), [Quantity] ) )
		lineageTag: m:Share Of Selected

	measure 'Running Qty' = CALCULATE ( [Quantity], FILTER ( ALLSELECTED ( 'Date'[Date] ), 'Date'[Date] <= MAX ( 'Date'[Date] ) ) )
		lineageTag: m:Running Qty

	measure 'Running Qty In Year' = CALCULATE ( [Quantity], FILTER ( ALLSELECTED ( 'Date'[MonthNumber] ), 'Date'[MonthNumber] <= MAX ( 'Date'[MonthNumber] ) ) )
		lineageTag: m:Running Qty In Year

	measure 'Running Qty All Time' = CALCULATE ( [Quantity], FILTER ( ALL ( 'Date'[Date] ), 'Date'[Date] <= MAX ( 'Date'[Date] ) ) )
		lineageTag: m:Running Qty All Time

	measure 'Busy Products Sales' = CALCULATE ( [Sales Amount], FILTER ( VALUES ( Product[Product] ), [Quantity] > 10 ) )
		lineageTag: m:Busy Products Sales

	measure 'Busy Colors Kept' = CALCULATE ( [Sales Amount], KEEPFILTERS ( FILTER ( ALL ( Product[Color] ), [Quantity] > 5 ) ) )
		lineageTag: m:Busy Colors Kept

	measure 'Cheaper Or Equal' = CALCULATE ( [Quantity], FILTER ( ALL ( Product ), Product[ListPrice] <= MAX ( Product[ListPrice] ) ) )
		lineageTag: m:Cheaper Or Equal

	measure 'Avg Qty Last 3 Months' = AVERAGEX ( DATESINPERIOD ( 'Date'[Date], MAX ( 'Date'[Date] ), -3, MONTH ), [Quantity] )
		lineageTag: m:Avg Qty Last 3 Months

	measure 'Best Month YTD' = MAXX ( DATESYTD ( 'Date'[Date] ), [Quantity] )
		lineageTag: m:Best Month YTD

	measure 'Months In Half Year' = COUNTROWS ( DATESINPERIOD ( 'Date'[Date], MAX ( 'Date'[Date] ), -6, MONTH ) )
		lineageTag: m:Months In Half Year

	measure 'Qty 3 Months To Last Month' = CALCULATE ( [Quantity], DATESINPERIOD ( 'Date'[Date], EOMONTH ( MAX ( 'Date'[Date] ), -1 ), -3, MONTH ) )
		lineageTag: m:Qty 3 Months To Last Month

	measure 'Qty Since Today' = CALCULATE ( [Quantity], DATESBETWEEN ( 'Date'[Date], TODAY (), BLANK () ) )
		lineageTag: m:Qty Since Today

	measure 'Qty Until Today' = CALCULATE ( [Quantity], DATESBETWEEN ( 'Date'[Date], BLANK (), TODAY () ) )
		lineageTag: m:Qty Until Today

	measure 'Qty From Mid 2024' = VAR mid2024 = DATE ( 2024, 6, 30 ) RETURN SUMX ( VALUES ( Store[Region] ), CALCULATE ( [Quantity], DATESBETWEEN ( 'Date'[Date], mid2024, MAX ( 'Date'[Date] ) ) ) )
		lineageTag: m:Qty From Mid 2024

	measure 'Qty Rank' = RANKX ( ALL ( Product[Product] ), [Quantity] )
		lineageTag: m:Qty Rank

	measure 'Qty Rank Asc Dense' = RANKX ( ALL ( Product[Product] ), [Quantity], , ASC, DENSE )
		lineageTag: m:Qty Rank Asc Dense

	measure 'Selected Qty Rank' = RANKX ( ALLSELECTED ( Product[Product] ), [Quantity] )
		lineageTag: m:Selected Qty Rank

	measure 'Tens Rank Skip' = RANKX ( ALL ( Product[Product] ), ROUND ( [Quantity] / 10, 0 ) )
		lineageTag: m:Tens Rank Skip

	measure 'Tens Rank Dense' = RANKX ( ALL ( Product[Product] ), ROUND ( [Quantity] / 10, 0 ), , DESC, DENSE )
		lineageTag: m:Tens Rank Dense

	measure 'List Price Rank' = RANKX ( ALL ( Product ), Product[ListPrice], MAX ( Product[ListPrice] ) )
		lineageTag: m:List Price Rank

	measure 'Category Rank' = RANKX ( ALL ( Product[Category] ), [Sales Amount] )
		lineageTag: m:Category Rank

	measure 'Top 3 Products Sales' = CALCULATE ( [Sales Amount], TOPN ( 3, ALL ( Product[Product] ), [Sales Amount] ) )
		lineageTag: m:Top 3 Products Sales

	measure 'Top 2 Products Qty' = SUMX ( TOPN ( 2, VALUES ( Product[Product] ), [Quantity] ), [Quantity] )
		lineageTag: m:Top 2 Products Qty

	measure 'Top Tens Count' = COUNTROWS ( TOPN ( 1, VALUES ( Product[Product] ), ROUND ( [Quantity] / 10, 0 ), DESC ) )
		lineageTag: m:Top Tens Count

	measure 'Cheapest Two' = SUMX ( TOPN ( 2, Product, Product[ListPrice], ASC ), Product[ListPrice] )
		lineageTag: m:Cheapest Two

	measure 'Colors List' = CONCATENATEX ( VALUES ( Product[Color] ), Product[Color], ", " )
		lineageTag: m:Colors List

	measure 'Products By Qty' = CONCATENATEX ( VALUES ( Product[Product] ), Product[Product], ", ", [Quantity], DESC )
		lineageTag: m:Products By Qty

	measure 'Region Quantities' = CONCATENATEX ( VALUES ( Store[Region] ), [Quantity], "|" )
		lineageTag: m:Region Quantities

	measure 'Red Sales Rows' = COUNTROWS ( CALCULATETABLE ( Sales, Product[Color] = "Red" ) )
		lineageTag: m:Red Sales Rows

	measure 'Lines Via Related Table' = SUMX ( Product, COUNTROWS ( RELATEDTABLE ( Sales ) ) )
		lineageTag: m:Lines Via Related Table

	measure 'Qty Of North Products' = SUMX ( CALCULATETABLE ( VALUES ( Product[Product] ), Store[Region] = "North" ), [Quantity] )
		lineageTag: m:Qty Of North Products

	measure 'Qty For North Products' = CALCULATE ( [Quantity], CALCULATETABLE ( VALUES ( Product[Product] ), Store[Region] = "North" ) )
		lineageTag: m:Qty For North Products

	measure 'Tent List Price' = LOOKUPVALUE ( Product[ListPrice], Product[Product], "Tent" )
		lineageTag: m:Tent List Price

	measure 'Price Of Top Key' = LOOKUPVALUE ( Product[ListPrice], Product[ProductKey], MAX ( Sales[ProductKey] ), -1 )
		lineageTag: m:Price Of Top Key

	measure 'Looked Up Value' = SUMX ( Sales, Sales[Qty] * LOOKUPVALUE ( Product[ListPrice], Product[ProductKey], Sales[ProductKey] ) )
		lineageTag: m:Looked Up Value

	measure 'Green Category' = LOOKUPVALUE ( Product[Category], Product[Color], "Green" )
		lineageTag: m:Green Category

	measure 'Best Category Sales' = MAXX ( ADDCOLUMNS ( VALUES ( Product[Category] ), "s", [Sales Amount] ), [s] )
		lineageTag: m:Best Category Sales

	measure 'Busy Categories' = COUNTROWS ( FILTER ( ADDCOLUMNS ( VALUES ( Product[Category] ), "q", [Quantity] ), [q] > 50 ) )
		lineageTag: m:Busy Categories

	measure 'Sold Colors' = COUNTROWS ( SUMMARIZE ( Sales, Product[Color] ) )
		lineageTag: m:Sold Colors

	measure 'Qty Over Category Regions' = SUMX ( SUMMARIZE ( Sales, Product[Category], Store[Region] ), [Quantity] )
		lineageTag: m:Qty Over Category Regions

	measure 'Selected Prices' = SUMX ( SELECTCOLUMNS ( Product, "p", Product[ListPrice] ), [p] )
		lineageTag: m:Selected Prices

	measure 'Best Category Qty' = MAXX ( SUMMARIZECOLUMNS ( Product[Category], "q", [Quantity] ), [q] )
		lineageTag: m:Best Category Qty

	measure 'Days In Q1 2024' = COUNTROWS ( CALENDAR ( DATE ( 2024, 1, 1 ), DATE ( 2024, 3, 31 ) ) )
		lineageTag: m:Days In Q1 2024

	measure 'Odd Sum' = SUMX ( GENERATESERIES ( 1, 10, 2 ), [Value] )
		lineageTag: m:Odd Sum

	measure 'Best Category Units' = MAXX ( SUMMARIZE ( Sales, Product[Category], "q", SUM ( Sales[Qty] ) ), [q] )
		lineageTag: m:Best Category Units

	measure 'Last 3 Months Via Var' = VAR p = DATESINPERIOD ( 'Date'[Date], MAX ( 'Date'[Date] ), -3, MONTH ) RETURN CALCULATE ( [Quantity], p )
		lineageTag: m:Last 3 Months Via Var

	measure 'Var Table Twice' = VAR t = ADDCOLUMNS ( VALUES ( Product[Category] ), "q", [Quantity] ) RETURN MAXX ( t, [q] ) + COUNTROWS ( t )
		lineageTag: m:Var Table Twice

	measure 'Average 12M Via Vars' = VAR d = MAX ( 'Date'[Date] ) VAR p = DATESINPERIOD ( 'Date'[Date], d, -12, MONTH ) RETURN CALCULATE ( AVERAGEX ( VALUES ( 'Date'[Date] ), [Quantity] ), p )
		lineageTag: m:Average 12M Via Vars

	measure 'Qty Mod 7' = MOD ( [Quantity], 7 )
		lineageTag: m:Qty Mod 7

	measure 'Negative Mod' = MOD ( -[Quantity], 4 )
		lineageTag: m:Negative Mod

	measure 'Nested Mod' = MOD ( MOD ( [Quantity] * 3, 17 ), -5 ) + ABS ( MOD ( BLANK (), 3 ) )
		lineageTag: m:Nested Mod

	measure 'Latest Weekday' = MAXX ( VALUES ( 'Date'[Date] ), WEEKDAY ( 'Date'[Date], 2 ) )
		lineageTag: m:Latest Weekday

	measure 'Weekday Sum' = SUMX ( VALUES ( 'Date'[Date] ), WEEKDAY ( 'Date'[Date] ) + WEEKDAY ( 'Date'[Date], 3 ) )
		lineageTag: m:Weekday Sum

	measure 'List Sum' = SUMX ( { 1, 2, [Quantity] }, [Value] )
		lineageTag: m:List Sum

	measure 'Rows Count' = COUNTROWS ( { ( "a", 1 ), ( "b", 2 ), ( "c", [Orders] ) } )
		lineageTag: m:Rows Count

	measure 'Rows Max' = MAXX ( { ( "a", 1 ), ( "b", [Quantity] ) }, [Value2] )
		lineageTag: m:Rows Max

	measure 'Rows Filtered' = SUMX ( FILTER ( { ( "a", 1 ), ( "b", 2 ), ( "c", 3 ) }, [Value1] <> "b" ), [Value2] )
		lineageTag: m:Rows Filtered

	measure 'Field Names' = CONCATENATEX ( { ( "Q", NAMEOF ( [Quantity] ), 0 ), ( "C", NAMEOF ( Product[Category] ), 1 ) }, [Value2], ", ", [Value3] )
		lineageTag: m:Field Names

	measure 'Calc Item Switch' = SWITCH ( SELECTEDVALUE ( Product[Category] ), "Apparel", CALCULATE ( ( 'Sales'[Quantity] ), SAMEPERIODLASTYEAR ( 'Date'[Date] ) ), "Camping", ( 'Sales'[Quantity] ) * 2, 'Sales'[Quantity] )
		lineageTag: m:Calc Item Switch

	measure 'Calc Items Nested' = SWITCH ( SELECTEDVALUE ( 'Date'[Year] ), 2025, ( SWITCH ( SELECTEDVALUE ( Product[Category] ), "Apparel", DIVIDE ( ( 'Sales'[Sales Amount] ), CALCULATE ( ( 'Sales'[Sales Amount] ), ALL ( Product ) ) ), 'Sales'[Sales Amount] ) ) + 1, SWITCH ( SELECTEDVALUE ( Product[Category] ), "Apparel", DIVIDE ( ( 'Sales'[Sales Amount] ), CALCULATE ( ( 'Sales'[Sales Amount] ), ALL ( Product ) ) ), 'Sales'[Sales Amount] ) )
		lineageTag: m:Calc Items Nested

	measure 'Neither Apparel Nor Camping' = CALCULATE ( [Quantity], Product[Category] <> "Apparel", Product[Category] <> "Camping" )
		lineageTag: m:Neither Apparel Nor Camping

	measure 'Camping If Busy' = CALCULATE ( [Sales Amount], Product[Category] = "Camping", FILTER ( VALUES ( Product[Category] ), [Orders] > 10 ) )
		lineageTag: m:Camping If Busy

	measure 'Since March 2025' = CALCULATE ( [Quantity], 'Date'[Date] >= DATE ( 2025, 3, 1 ) )
		lineageTag: m:Since March 2025

	measure 'Camping Sales' = CALCULATE ( [Sales Amount], Product[Category] = "Camping" )
		lineageTag: m:Camping Sales

	measure 'Not Camping' = CALCULATE ( [Sales Amount], Product[Category] <> "Camping" )
		lineageTag: m:Not Camping

	measure 'All Products' = CALCULATE ( [Sales Amount], ALL ( Product ) )
		lineageTag: m:All Products

	measure 'Share Of Category' = DIVIDE ( [Sales Amount], CALCULATE ( [Sales Amount], ALL ( Product[Category] ) ) )
		lineageTag: m:Share Of Category

	measure 'All Sales' = CALCULATE ( [Sales Amount], REMOVEFILTERS ( Sales ) )
		lineageTag: m:All Sales

	measure 'All Years' = CALCULATE ( [Quantity], ALL ( 'Date'[Year] ) )
		lineageTag: m:All Years

	measure 'Year 2024' = CALCULATE ( [Quantity], 'Date'[Year] = 2024 )
		lineageTag: m:Year 2024

	measure 'Keep 2024' = CALCULATE ( [Quantity], KEEPFILTERS ( 'Date'[Year] = 2024 ) )
		lineageTag: m:Keep 2024

	measure 'Green Or Red' = CALCULATE ( [Quantity], Product[Color] IN { "Green", "Red" } )
		lineageTag: m:Green Or Red

	measure 'Two Filters' = CALCULATE ( [Quantity], Product[Category] = "Apparel", Store[Region] = "Online" )
		lineageTag: m:Two Filters

	measure 'Big Orders Sales' = CALCULATE ( [Sales Amount], Sales[Qty] >= 3 )
		lineageTag: m:Big Orders Sales

	measure 'Filter Table' = CALCULATE ( [Quantity], FILTER ( ALL ( Product[ListPrice] ), Product[ListPrice] > 100 ) )
		lineageTag: m:Filter Table

	measure 'Filter Rows' = CALCULATE ( [Quantity], FILTER ( Sales, Sales[Price] > 100 ) )
		lineageTag: m:Filter Rows

	measure 'Except Category' = CALCULATE ( [Quantity], ALLEXCEPT ( Product, Product[Category] ) )
		lineageTag: m:Except Category

	measure 'By Ship Date' = CALCULATE ( [Quantity], USERELATIONSHIP ( Sales[ShipDateKey], 'Date'[DateKey] ) )
		lineageTag: m:By Ship Date

	measure 'Ship Orders' = CALCULATE ( [Orders], USERELATIONSHIP ( Sales[ShipDateKey], 'Date'[DateKey] ) )
		lineageTag: m:Ship Orders

	measure 'Restore Values' = CALCULATE ( [Quantity], ALL ( Product ), VALUES ( Product[Category] ) )
		lineageTag: m:Restore Values

	measure 'All Selected' = CALCULATE ( [Quantity], ALLSELECTED ( Product[Category] ) )
		lineageTag: m:All Selected

	measure 'Nested Calc' = CALCULATE ( CALCULATE ( [Quantity], ALL ( Product ) ), Product[Category] = "Footwear" )
		lineageTag: m:Nested Calc

	measure 'Target All Stores' = CALCULATE ( [Target], ALL ( Store ) )
		lineageTag: m:Target All Stores

	measure 'Calc Var' = VAR everything = CALCULATE ( [Quantity], ALL ( Product ) ) RETURN DIVIDE ( [Quantity], everything )
		lineageTag: m:Calc Var

	measure 'Transition Sum' = SUMX ( VALUES ( Product[Category] ), CALCULATE ( [Quantity] ) )
		lineageTag: m:Transition Sum

	measure 'Iterate Calc' = SUMX ( VALUES ( 'Date'[Year] ), CALCULATE ( [Sales Amount], ALL ( Product ) ) )
		lineageTag: m:Iterate Calc

	measure 'Selected Category' = SELECTEDVALUE ( Product[Category], "Many" )
		lineageTag: m:Selected Category

	measure 'One Year' = IF ( HASONEVALUE ( 'Date'[Year] ), "one", "many" )
		lineageTag: m:One Year

	measure 'Category In Scope' = IF ( ISINSCOPE ( Product[Category] ), 1, 0 )
		lineageTag: m:Category In Scope

	measure 'Year Filtered' = IF ( ISFILTERED ( 'Date'[Year] ), 1, 0 )
		lineageTag: m:Year Filtered

	measure 'Sales LY' = CALCULATE ( [Sales Amount], SAMEPERIODLASTYEAR ( 'Date'[Date] ) )
		lineageTag: m:Sales LY

	measure 'YoY %' = DIVIDE ( [Sales Amount] - [Sales LY], [Sales LY] )
		lineageTag: m:YoY %

	measure 'Qty Prev Month' = CALCULATE ( [Quantity], DATEADD ( 'Date'[Date], -1, MONTH ) )
		lineageTag: m:Qty Prev Month

	measure 'Qty Next Quarter' = CALCULATE ( [Quantity], DATEADD ( 'Date'[Date], 1, QUARTER ) )
		lineageTag: m:Qty Next Quarter

	measure 'Sales YTD' = TOTALYTD ( [Sales Amount], 'Date'[Date] )
		lineageTag: m:Sales YTD

	measure 'Qty FYTD' = TOTALYTD ( [Quantity], 'Date'[Date], "6/30" )
		lineageTag: m:Qty FYTD

	measure 'Qty QTD' = TOTALQTD ( [Quantity], 'Date'[Date] )
		lineageTag: m:Qty QTD

	measure 'Qty MTD' = CALCULATE ( [Quantity], DATESMTD ( 'Date'[Date] ) )
		lineageTag: m:Qty MTD

	measure 'Camping YTD' = TOTALYTD ( [Quantity], 'Date'[Date], Product[Category] = "Camping" )
		lineageTag: m:Camping YTD

	measure 'Qty Parallel' = CALCULATE ( [Quantity], PARALLELPERIOD ( 'Date'[Date], -1, YEAR ) )
		lineageTag: m:Qty Parallel

	measure 'Qty Prev Year' = CALCULATE ( [Quantity], PREVIOUSYEAR ( 'Date'[Date] ) )
		lineageTag: m:Qty Prev Year

	measure 'Qty Prev Quarter' = CALCULATE ( [Quantity], PREVIOUSQUARTER ( 'Date'[Date] ) )
		lineageTag: m:Qty Prev Quarter

	measure 'Qty Next Month' = CALCULATE ( [Quantity], NEXTMONTH ( 'Date'[Date] ) )
		lineageTag: m:Qty Next Month

	measure 'Keep LY' = CALCULATE ( [Quantity], KEEPFILTERS ( SAMEPERIODLASTYEAR ( 'Date'[Date] ) ) )
		lineageTag: m:Keep LY

	measure 'Latest Year' = MAXX ( 'Date', YEAR ( 'Date'[Date] ) )
		lineageTag: m:Latest Year

	measure 'Quarter Days' = SUMX ( VALUES ( 'Date'[Date] ), QUARTER ( 'Date'[Date] ) * 100 + MONTH ( 'Date'[Date] ) + DAY ( 'Date'[Date] ) )
		lineageTag: m:Quarter Days

	measure 'Target LY' = CALCULATE ( [Target], SAMEPERIODLASTYEAR ( 'Date'[Date] ) )
		lineageTag: m:Target LY

	measure 'Scoped Share' = IF ( ISINSCOPE ( Product[Category] ), [Share Of Category], BLANK () )
		lineageTag: m:Scoped Share

	measure 'Rolling 12M' = CALCULATE ( [Sales Amount], DATESINPERIOD ( 'Date'[Date], MAX ( 'Date'[Date] ), -12, MONTH ) )
		lineageTag: m:Rolling 12M

	measure 'Rolling 3M Var' = VAR last = LASTDATE ( 'Date'[Date] ) RETURN CALCULATE ( [Quantity], DATESINPERIOD ( 'Date'[Date], last, -3, MONTH ) )
		lineageTag: m:Rolling 3M Var

	measure 'Next 2 Quarters' = CALCULATE ( [Quantity], DATESINPERIOD ( 'Date'[Date], MIN ( 'Date'[Date] ), 2, QUARTER ) )
		lineageTag: m:Next 2 Quarters

	measure 'Last 45 Days' = CALCULATE ( [Quantity], DATESINPERIOD ( 'Date'[Date], LASTDATE ( 'Date'[Date] ), -45, DAY ) )
		lineageTag: m:Last 45 Days

	measure 'Year Back' = CALCULATE ( [Quantity], DATESINPERIOD ( 'Date'[Date], MAX ( 'Date'[Date] ), -1, YEAR ) )
		lineageTag: m:Year Back

	measure 'H1 2025' = CALCULATE ( [Quantity], DATESBETWEEN ( 'Date'[Date], DATE ( 2025, 1, 1 ), DATE ( 2025, 6, 30 ) ) )
		lineageTag: m:H1 2025

	measure 'Running Qty To Date' = CALCULATE ( [Quantity], DATESBETWEEN ( 'Date'[Date], BLANK (), MAX ( 'Date'[Date] ) ) )
		lineageTag: m:Running Qty To Date

	measure 'From First' = CALCULATE ( [Quantity], DATESBETWEEN ( 'Date'[Date], FIRSTDATE ( 'Date'[Date] ), BLANK () ) )
		lineageTag: m:From First

	measure 'No Filters' = CALCULATE ( [Quantity], REMOVEFILTERS () )
		lineageTag: m:No Filters

	measure 'Share Of All' = DIVIDE ( [Quantity], CALCULATE ( [Quantity], ALL () ) )
		lineageTag: m:Share Of All

	measure 'Int Price' = INT ( [Avg Price] )
		lineageTag: m:Int Price

	measure 'Int Negative' = INT ( -[Price Per Unit] )
		lineageTag: m:Int Negative

	measure 'Int Flag' = INT ( [Avg Price] > 10 )
		lineageTag: m:Int Flag

	measure 'Pi Qty' = ROUND ( PI () * [Quantity], 2 )
		lineageTag: m:Pi Qty

	measure Smaller = MIN ( [Sales Amount], [Target] )
		lineageTag: m:Smaller

	measure 'At Least 10' = MAX ( [Quantity], 10 )
		lineageTag: m:At Least 10

	measure 'Max With Blank' = MAX ( [Missing Amounts], -1 )
		lineageTag: m:Max With Blank

	measure 'Later Date' = MAX ( LASTDATE ( 'Date'[Date] ), DATE ( 2025, 6, 30 ) )
		lineageTag: m:Later Date

	measure 'Upper Category' = IF ( [Quantity] > 0, UPPER ( SELECTEDVALUE ( Product[Category] ) ) )
		lineageTag: m:Upper Category

	measure 'Category Code' = IF ( [Quantity] > 0, LEFT ( SELECTEDVALUE ( Product[Category] ) & "all", 3 ) & "-" & RIGHT ( SELECTEDVALUE ( Product[Category] ), 2 ) & LEFT ( "xyz" ) )
		lineageTag: m:Category Code

	measure 'Category Length' = IF ( [Quantity] > 0, LEN ( SELECTEDVALUE ( Product[Color] ) ) )
		lineageTag: m:Category Length

	measure 'Mid Lower' = IF ( [Quantity] > 0, LOWER ( MID ( SELECTEDVALUE ( Product[Category] ) & " Products", 2, 4 ) ) )
		lineageTag: m:Mid Lower

	measure Trimmed = IF ( [Quantity] > 0, TRIM ( "  big   " & SELECTEDVALUE ( Product[Category] ) & "  " ) )
		lineageTag: m:Trimmed

	measure Substituted = IF ( [Quantity] > 0, SUBSTITUTE ( SELECTEDVALUE ( Product[Category] ) & " aaa", "a", "o" ) )
		lineageTag: m:Substituted

	measure 'Second A' = IF ( [Quantity] > 0, SUBSTITUTE ( "banana " & SELECTEDVALUE ( Product[Category] ), "a", "_", 2 ) )
		lineageTag: m:Second A

	measure Joined = IF ( [Quantity] > 0, CONCATENATE ( SELECTEDVALUE ( Product[Category] ) & "-", FORMAT ( [Quantity], "0" ) ) )
		lineageTag: m:Joined

	measure 'Blank Arguments' = IF ( [Quantity] > 0, LEN ( BLANK () ) + LEN ( UPPER ( BLANK () ) & LEFT ( BLANK (), 2 ) ) + LEN ( FORMAT ( BLANK (), "0" ) ) + MIN ( BLANK (), 3 ) + LEN ( SUBSTITUTE ( BLANK (), BLANK (), "x" ) ) )
		lineageTag: m:Blank Arguments

	measure 'Amount Text' = FORMAT ( [Sales Amount], "#,0.00" )
		lineageTag: m:Amount Text

	measure 'Share Text' = FORMAT ( [Share Of Category], "0.0%" )
		lineageTag: m:Share Text

	measure 'Price Text' = FORMAT ( [Avg Price], "$#,##0.00" )
		lineageTag: m:Price Text

	measure 'Gap Text' = FORMAT ( [Gap], "#,0" )
		lineageTag: m:Gap Text

	measure 'General Text' = FORMAT ( [Price Per Unit], "General Number" )
		lineageTag: m:General Text

	measure 'Number Texts' = 1 / 3 & "|" & 1 / 30000 & "|" & 1 / 3000 & "|" & 0.0000333333 & "|" & 1000000 * 1000000 * 1000 & "|" & 10 / 3 * 1000000000000000000 & "|" & -2 / 3 & "|" & 123456.5 & "|" & [Quantity] / 7
		lineageTag: m:Number Texts

	measure 'Last Month Name' = FORMAT ( LASTDATE ( 'Date'[Date] ), "mmm yyyy" )
		lineageTag: m:Last Month Name

	measure 'Last Date Text' = FORMAT ( MAX ( 'Date'[Date] ), "dddd dd/mm/yy" )
		lineageTag: m:Last Date Text

	measure 'First Month' = FORMAT ( MIN ( 'Date'[Date] ), "yyyy-MM" ) & " " & FORMAT ( MIN ( 'Date'[Date] ), "MMMM d" )
		lineageTag: m:First Month

	measure 'Month End' = EOMONTH ( MIN ( 'Date'[Date] ), 1 )
		lineageTag: m:Month End

	measure 'Quarter Back' = EOMONTH ( MAX ( 'Date'[Date] ), -3 )
		lineageTag: m:Quarter Back

	measure 'Month Later' = EDATE ( MAX ( 'Date'[Date] ), 1 )
		lineageTag: m:Month Later

	measure 'Date Overflow' = DATE ( 2024, 14, 0 )
		lineageTag: m:Date Overflow

	measure 'Next Month Start' = DATE ( MAX ( 'Date'[Year] ), MAX ( 'Date'[MonthNumber] ) + 1, 1 )
		lineageTag: m:Next Month Start

	measure 'Date Span' = DATEDIFF ( FIRSTDATE ( 'Date'[Date] ), LASTDATE ( 'Date'[Date] ), MONTH ) * 100 + DATEDIFF ( MIN ( 'Date'[Date] ), MAX ( 'Date'[Date] ), QUARTER ) * 10 + DATEDIFF ( MIN ( 'Date'[Date] ), MAX ( 'Date'[Date] ), YEAR )
		lineageTag: m:Date Span

	measure 'Days Before' = DATEDIFF ( MAX ( 'Date'[Date] ), DATE ( 2024, 1, 1 ), DAY )
		lineageTag: m:Days Before

	column OrderId
		dataType: int64
		lineageTag: Sales.OrderId
		sourceColumn: OrderId

		annotation SummarizationSetBy = Automatic

